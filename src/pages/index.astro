---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, sections, type Section } from '../sections';

const published = (e: { data: { draft: boolean } }) => !e.data.draft;
const latest = await Promise.all(
	(Object.keys(sections) as Section[]).map(async (key) => {
		const entries = (await getCollection(key, published)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
		return { key, entries: entries.slice(0, 3) };
	}),
);
---

<Base>
	<h1>Hi, I'm Sid.</h1>
	<p>A personal archive of my life and what I've been up to — where I've travelled, what I've worked on, and how I've tried to give back.</p>

	{
		latest.map(({ key, entries }) => (
			<section>
				<h2><a href={`/${key}/`}>{sections[key].label}</a></h2>
				<p class="muted">{sections[key].blurb}</p>
				{entries.length === 0 ? (
					<p class="muted">Nothing here yet.</p>
				) : (
					<ul class="entries">
						{entries.map((e) => (
							<li>
								<a href={`/${key}/${e.id}/`}>{e.data.title}</a> <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date, 'medium')}</time>
							</li>
						))}
					</ul>
				)}
			</section>
		))
	}
</Base>
